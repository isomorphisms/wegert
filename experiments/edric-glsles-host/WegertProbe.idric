module WegertProbe

import Shader.PhasePortrait
import Shader.Source

%default total

||| Host-only compiler probe for the real Wegert rational phase portrait.
||| This deliberately exercises the same 64-zero/64-pole shader mathematics
||| as the GLSL backend's Wegert example without involving Android or ICK.
%export "glsles:fragment|v_ndc=in,u_center=uniform,u_half_height=uniform,u_aspect=uniform,u_zero_count=uniform,u_pole_count=uniform,u_zeros=uniform,u_poles=uniform"
wegert_probe :
  SVec 2 -> SVec 2 -> Double -> Double -> Int -> Int ->
  SArray 64 (SVec 2) -> SArray 64 (SVec 2) -> SVec 4
wegert_probe ndc center half_height aspect zero_count pole_count zeros poles =
  let point = vadd center (vec2 (x ndc * half_height * aspect)
                                (y ndc * half_height))
      color = wegert_rgb point
                         (int_to_double zero_count) zeros
                         (int_to_double pole_count) poles
   in vec4 (x color) (y color) (z color) 1.0

main : IO ()
main = pure ()
